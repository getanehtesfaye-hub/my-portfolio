NODE_ENV=development
PORT=4000
# Option A: Supabase (Project Settings > Database > Connection string, Session pooler). Replace [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Option B: local PostgreSQL (works offline, no SSL needed)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/portfolio
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# One-time secret required to create the first admin. Any random 16+ characters.
SETUP_TOKEN=
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# Only needed for Supabase Storage media uploads. Server-side only, never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
